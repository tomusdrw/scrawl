# Generated by scripts/build-omarchy-package.py from a source snapshot.
pkgname=scrawl
pkgver=@VERSION@
pkgrel=1
pkgdesc='Screen, voice and drawing capture for Omarchy (Hyprland/Wayland)'
arch=('x86_64')
url='https://github.com/kitlangton/scrawl'
license=('MIT')
depends=(
  'glibc' 'gcc-libs' 'hyprland' 'wf-recorder' 'ffmpeg' 'wl-clipboard'
  'slurp' 'libpulse' 'pipewire-pulse' 'python' 'python-gobject'
  'python-cairo' 'gtk4' 'gtk4-layer-shell' 'xdg-utils'
)
makedepends=('rust' 'alsa-lib')
checkdepends=('desktop-file-utils')
optdepends=(
  'whisper-cpp: local speech transcription with a separately supplied model'
  'ggml-vulkan: optional Whisper GPU acceleration on AMD, Intel or NVIDIA'
  'ggml-cuda: optional Whisper GPU acceleration on NVIDIA'
)
source=('scrawl-source.tar.gz')
sha256sums=('@SOURCE_SHA256@')
options=('!lto' '!debug')

_scrawl_cargo() {
  CARGO_TARGET_DIR="$srcdir/target" \
    CARGO_BUILD_JOBS="${CARGO_BUILD_JOBS:-3}" \
    RUSTFLAGS="${RUSTFLAGS:-} -C target-cpu=x86-64 --remap-path-prefix=$srcdir=/usr/src/debug/scrawl --remap-path-prefix=${CARGO_HOME:-$HOME/.cargo}=/usr/src/debug/cargo" \
    cargo "$@"
}

prepare() {
  cd "$srcdir/scrawl"
  _scrawl_cargo fetch --locked --target x86_64-unknown-linux-gnu
}

build() {
  cd "$srcdir/scrawl"
  _scrawl_cargo build --release --frozen --target x86_64-unknown-linux-gnu
}

check() {
  cd "$srcdir/scrawl"
  _scrawl_cargo test --release --frozen --target x86_64-unknown-linux-gnu -- --test-threads=2
  PYTHONDONTWRITEBYTECODE=1 python -m unittest discover -s helper -p test_linux.py
  PYTHONDONTWRITEBYTECODE=1 python tests/linux_smoke.py "$srcdir/target/x86_64-unknown-linux-gnu/release/scrawl"
  desktop-file-validate packaging/omarchy/scrawl.desktop
}

package() {
  cd "$srcdir/scrawl"
  install -Dm755 "$srcdir/target/x86_64-unknown-linux-gnu/release/scrawl" "$pkgdir/usr/bin/scrawl"
  install -Dm644 packaging/omarchy/scrawl.desktop "$pkgdir/usr/share/applications/scrawl.desktop"
  install -Dm644 assets/app-icon.png "$pkgdir/usr/share/icons/hicolor/1024x1024/apps/scrawl.png"
  install -Dm644 packaging/omarchy/omarchy.lua "$pkgdir/usr/share/doc/scrawl/omarchy.lua"
  install -Dm644 docs/linux.md "$pkgdir/usr/share/doc/scrawl/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/scrawl/LICENSE"
}
